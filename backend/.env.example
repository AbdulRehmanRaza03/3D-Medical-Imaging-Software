# OrthoVision AI — backend environment configuration.
# Copy to `.env` and adjust as needed. Never commit `.env` or real secrets.

# --- App ---
APP_NAME=OrthoVision AI
APP_ENV=development
DEBUG=false

# --- Storage (relative to the backend working directory) ---
STORAGE_DIR=./storage

# --- Upload limits ---
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_FILES_PER_UPLOAD=5000

# --- Database (SQLite default; use a Postgres URL for production) ---
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/orthovision
DATABASE_URL=sqlite:///./orthovision.db

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000
