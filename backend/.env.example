# OrthoVision AI backend — environment variable template.
# Copy to `.env` for local development; for production set these on your host
# (Render / Fly.io) or in your deployment platform's secrets manager.

# ==============================
# App
# ==============================
APP_NAME=OrthoVision AI
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1

# ==============================
# Storage (binary artifacts: DICOM / volume / mesh / mask)
# ==============================
# Local filesystem directory (only used when STORAGE_BACKEND=local).
STORAGE_DIR=./storage
# "local" (filesystem) or "s3" (S3-compatible object storage).
STORAGE_BACKEND=local

# --- Object storage (only when STORAGE_BACKEND=s3) ---
# Supabase Storage, Cloudflare R2, AWS S3, or MinIO.
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ==============================
# Upload limits
# ==============================
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_FILES_PER_UPLOAD=5000

# ==============================
# Database
# ==============================
# SQLite for local dev; PostgreSQL for production (Supabase / Neon / RDS).
# Supabase: Project Settings -> Database -> Connection string (session pooler).
DATABASE_URL=sqlite:///./orthovision.db

# ==============================
# Job queue (background reconstruction / segmentation)
# ==============================
# "local" (in-process threads, dev) or "redis" (RQ queue, production).
JOB_BACKEND=local
# Only used when JOB_BACKEND=redis. Use the Redis URL from your provider
# (Upstash, Railway Redis, Render Redis, or self-hosted).
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE=orthovision

# ==============================
# AI segmentation (optional)
# ==============================
# Directory containing trained model checkpoints (default: ai/segmentation/models).
# OV_MODELS_DIR=/app/ai/segmentation/models

# ==============================
# CORS
# ==============================
# Comma-separated list of allowed origins (your Vercel frontend URL).
CORS_ORIGINS=http://localhost:3000

# ==============================
# Processing
# ==============================
DEFAULT_RECONSTRUCTION_THRESHOLD_HU=300
